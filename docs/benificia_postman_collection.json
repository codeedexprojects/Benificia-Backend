                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"City Diagnostic Centre\",\n  \"phone\": \"+919876543210\",\n  \"email\": \"info@citydiagnostic.in\",\n  \"website\": \"https://citydiagnostic.in\",\n  \"addressLine1\": \"12, MG Road\",\n  \"city\": \"Bengaluru\",\n  \"state\": \"Karnataka\",\n  \"pincode\": \"560001\",\n  \"centreType\": \"diagnostic_lab\",\n  \"specialities\": [\"pathology\", \"radiology\"],\n  \"isFree\": false,\n  \"minFee\": 200,\n  \"maxFee\": 5000,\n  \"services\": [\n    { \"name\": \"CBC\", \"price\": 300, \"isFree\": false },\n    { \"name\": \"ECG\", \"price\": 200, \"isFree\": false }\n  ],\n  \"isVerified\": true,\n  \"openingHours\": {\n    \"mon\": \"8:00-20:00\",\n    \"tue\": \"8:00-20:00\",\n    \"wed\": \"8:00-20:00\",\n    \"thu\": \"8:00-20:00\",\n    \"fri\": \"8:00-20:00\",\n    \"sat\": \"8:00-18:00\",\n    \"sun\": \"9:00-14:00\"\n  }\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/admin/health-centres",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "admin", "health-centres"]
                }
              }
            },
