        {
          "name": "Fact Finding",
          "item": [
            {
              "name": "Get Status",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/api/v1/fact-finding/status",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "fact-finding", "status"]
                },
                "description": "Returns current stage and all saved answers for pre-filling Previous/Edit screens."
              }
            },
            {
              "name": "Save Income",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"incomeSources\": [\"full_time_salary\"],\n  \"salaryMonthly\": 80000,\n  \"freelanceMonthly\": 0,\n  \"businessMonthly\": 0,\n  \"otherMonthly\": 5000,\n  \"salaryPeriod\": \"monthly\",\n  \"freelancePeriod\": \"monthly\",\n  \"businessPeriod\": \"monthly\",\n  \"otherPeriod\": \"monthly\",\n  \"residentialProperty\": 0,\n  \"investment\": 150000,\n  \"savingsBank\": 200000,\n  \"goldJewelry\": 100000,\n  \"retirementFunds\": 250000,\n  \"otherAssets\": 0\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/fact-finding/income",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "fact-finding", "income"]
                },
                "description": "Finance step 1: income sources, amounts (monthly), and assets. All amounts must already be monthly (frontend converts yearly÷12 before sending)."
              }
            },
            {
              "name": "Save Finance Profile",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"frequency\": \"monthly\",\n  \"numberOfDependents\": 2,\n  \"householdExpenses\": 15000,\n  \"rentAndEmi\": 20000,\n  \"educationExpenses\": 5000,\n  \"otherExpenses\": 3000,\n  \"insuranceMonthly\": 2000,\n  \"creditCardDues\": 0,\n  \"personalLoan\": 0,\n  \"medicalExpenses\": 1000,\n  \"otherShortTermExpenses\": 0,\n  \"homeLoan\": 1200000,\n  \"vehicleLoan\": 400000,\n  \"educationLoan\": 0,\n  \"businessLoan\": 0,\n  \"otherLongTermExpenses\": 0\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/fact-finding/finance-profile",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "fact-finding", "finance-profile"]
                },
                "description": "Finance step 2: dependents, spend breakdown, insurance, and liabilities."
              }
            },
            {
              "name": "Save Goals",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"financialAims\": [\"retirement\", \"wealth_building\"],\n  \"timeHorizon\": \"long_7_plus\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/fact-finding/goals",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "fact-finding", "goals"]
                },
                "description": "Finance step 3: financial aims and time horizon. financialAims values: retirement, home_ownership, education, wealth_building, repay_debts, other. timeHorizon values: short_1_3, medium_3_7, long_7_plus."
              }
            },
            {
              "name": "Save Risk Profile",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"portfolioDrop\": \"wait_it_out\",\n  \"investmentStyle\": \"moderate\",\n  \"marketFeeling\": \"neutral\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/fact-finding/risk",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "fact-finding", "risk"]
                },
                "description": "portfolioDrop: sell_everything | wait_it_out | buy_more. investmentStyle: conservative | moderate | aggressive. marketFeeling: very_anxious | neutral | excited."
              }
            },
            {
              "name": "Skip Risk Profile",
              "request": {
                "method": "POST",
                "url": {
                  "raw": "{{baseUrl}}/api/v1/fact-finding/risk/skip",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "fact-finding", "risk", "skip"]
                },
                "description": "Skip the risk assessment step (optional step)."
              }
            }
