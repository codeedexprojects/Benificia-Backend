{
  "info": {
    "name": "Benificia API Collection",
    "description": "Comprehensive API Documentation for Benificia API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "User APIs",
      "item": [
        {
          "name": "Auth",
          "item": [
            {
              "name": "Get CSRF Token",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/api/v1/auth/csrf-token",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "auth", "csrf-token"]
                }
              }
            },
            {
              "name": "Send OTP",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"identifier\": \"user@example.com\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/auth/otp/send",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "auth", "otp", "send"]
                },
                "description": "Accepts email or E.164 phone number — channel is auto-detected."
              }
            },
            {
              "name": "Verify OTP",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test(\"Status 200 or 201\", function () {",
                      "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                      "});"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"identifier\": \"user@example.com\",\n  \"otp\": \"123456\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/auth/otp/verify",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "auth", "otp", "verify"]
                },
                "description": "Accepts email or E.164 phone number — channel is auto-detected."
              }
            },
            {
              "name": "Refresh Token",
              "request": {
                "method": "POST",
                "url": {
                  "raw": "{{baseUrl}}/api/v1/auth/refresh",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "auth", "refresh"]
                }
              }
            },
            {
              "name": "Logout",
              "request": {
                "method": "POST",
                "url": {
                  "raw": "{{baseUrl}}/api/v1/auth/logout",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "auth", "logout"]
                }
              }
            }
          ]
        },
