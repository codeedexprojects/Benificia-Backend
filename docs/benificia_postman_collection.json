        {
          "name": "Health Centres (Public)",
          "item": [
            {
              "name": "List Health Centres",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/api/v1/health-centres?page=1&limit=20",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "health-centres"],
                  "query": [
                    { "key": "page", "value": "1" },
                    { "key": "limit", "value": "20" },
                    { "key": "search", "value": "", "disabled": true },
                    { "key": "city", "value": "", "disabled": true },
                    { "key": "state", "value": "", "disabled": true },
                    { "key": "pincode", "value": "", "disabled": true },
                    { "key": "centreType", "value": "", "disabled": true },
                    { "key": "isFree", "value": "true", "disabled": true },
                    { "key": "isVerified", "value": "true", "disabled": true },
                    { "key": "speciality", "value": "", "disabled": true }
                  ]
                }
              }
            },
            {
              "name": "Get Health Centre by ID",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/api/v1/health-centres/{{healthCentreId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "health-centres", "{{healthCentreId}}"]
                }
              }
            }
          ]
        },
        {
          "name": "Upload",
          "item": [
            {
              "name": "Request Upload URL",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "var json = pm.response.json();",
                      "if (json && json.data && json.data.url) {",
                      "    pm.environment.set(\"uploadUrl\", json.data.url);",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"category\": \"kyc_document\",\n  \"contentType\": \"application/pdf\",\n  \"docType\": \"pan_card\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/upload/url",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "upload", "url"]
                },
                "description": "category: profile_photo | kyc_document. contentType: image/jpeg | image/png | image/webp | application/pdf. docType required when category is kyc_document."
              }
            },
            {
              "name": "Get Download URL",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/api/v1/upload/url?key={{fileKey}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "upload", "url"],
                  "query": [{ "key": "key", "value": "{{fileKey}}" }]
                }
              }
            },
            {
              "name": "Delete File",
              "request": {
                "method": "DELETE",
                "url": {
                  "raw": "{{baseUrl}}/api/v1/upload/url?key={{fileKey}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "upload", "url"],
                  "query": [{ "key": "key", "value": "{{fileKey}}" }]
                }
              }
            }
          ]
