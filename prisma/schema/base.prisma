// ════════════════════════════════════════════════════════════
// prisma/schema/base.prisma
// Generator, Datasource & All Enums
// ════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ─────────────────────────────────────────────────

enum ProfileStage {
  auth_complete
  personal_complete
  fact_finding_income_sources
  fact_finding_dependents
  fact_finding_liabilities
  fact_finding_insurance
  fact_finding_income_amount
  fact_finding_expenses
  fact_finding_assets
  fact_finding_complete
  recommendations_ready
}

enum Gender {
  male
  female
  other
  prefer_not_to_say
}

enum MaritalStatus {
  single
  married
  divorced
  widowed
}

enum IncomeType {
  fixed
  business
  freelance
}

enum RiskCategory {
  conservative
  moderate
  aggressive
}

enum GoalType {
  emergency_fund
  child_education
  house_purchase
  retirement
  wealth_creation
  debt_repayment
}

// ── Income ────────────────────────────────────────────────────

enum IncomeSource {
  full_time_salary
  freelance_contract
  business_owner
  passive_income
  other
}

// ── Assets ────────────────────────────────────────────────────

enum AssetType {
  cash_savings
  fixed_deposit
  mutual_funds_stocks
  gold
  real_estate
  epf_ppf
  other
}

// ── Liabilities ───────────────────────────────────────────────

enum LiabilityType {
  credit_card_debt
  personal_loan
  mortgage
}

// ── Insurance Coverage ────────────────────────────────────────

enum InsuranceCoverageType {
  health_insurance
  life_insurance
  property_insurance
}

// ── Risk Profile ──────────────────────────────────────────────

enum PortfolioDrop {
  sell_everything
  wait_it_out
  buy_more
}

enum InvestmentStyle {
  conservative
  moderate
  aggressive
}

enum FinancialAim {
  retirement
  home_ownership
  education
  wealth_building
  repay_debts
}

enum TimeHorizon {
  short_1_3
  medium_3_7
  long_7_plus
}

enum MarketFeeling {
  very_anxious
  neutral
  excited
}

enum InsuranceType {
  term
  health
  ulip
  endowment
  vehicle
}

enum ProductRiskLevel {
  low
  moderate
  high
}

enum InterestStatus {
  pending
  contacted
  converted
  dropped
}

enum RecommendationStatus {
  generating
  ready
  stale
  failed
}

enum OtpPurpose {
  registration
  login
  mfa
  password_reset
}

enum OtpChannel {
  email
  phone
}

enum AdminRole {
  super_admin
  product_admin
  support_agent
  analytics_viewer
}
