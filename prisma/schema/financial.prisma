// ════════════════════════════════════════════════════════════
// prisma/schema/financial.prisma
// MODULE 3 — Financial Fact Finding
// ════════════════════════════════════════════════════════════

// Screen: Finance 1 — income sources (multi-select)
model IncomeSourcesProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  incomeSources IncomeSource[] @map("income_sources")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("income_sources_profiles")
}

// Screen: Finance 2 — dependents, liabilities, insurance
model FinanceProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  numberOfDependents     Int                    @default(0) @map("number_of_dependents")
  liabilityTypes         LiabilityType[]        @map("liability_types")
  insuranceCoverageTypes InsuranceCoverageType[] @map("insurance_coverage_types")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("finance_profiles")
}

// Screen: Finance 3 — total monthly income amount
model IncomeProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  // Amounts — monthly (frontend divides yearly by 12 before sending)
  salaryMonthly    Float @default(0) @map("salary_monthly")
  freelanceMonthly Float @default(0) @map("freelance_monthly")
  businessMonthly  Float @default(0) @map("business_monthly")
  passiveMonthly   Float @default(0) @map("passive_monthly")
  otherMonthly     Float @default(0) @map("other_monthly")
  totalMonthly     Float @default(0) @map("total_monthly")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("income_profiles")
}

model ExpenseProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  // Total monthly spend (frontend converts yearly → monthly before sending)
  totalMonthly    Float @default(0) @map("total_monthly")

  // Computed — stored for dashboard reads
  monthlySurplus  Float @default(0) @map("monthly_surplus")
  savingsRatioPct Float @default(0) @map("savings_ratio_pct")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("expense_profiles")
}

// Screen: Finance 5 — assets list
model AssetLiabilityProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  // Total amounts (summed from UserAsset entries)
  totalAssets Float @default(0) @map("total_assets")
  netWorth    Float @default(0) @map("net_worth")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  assets UserAsset[]

  @@index([userId])
  @@map("asset_liability_profiles")
}

model UserAsset {
  id                      String                @id @default(uuid()) @db.Uuid
  assetLiabilityProfileId String                @map("asset_liability_profile_id") @db.Uuid
  assetType               AssetType             @map("asset_type")
  amount                  Float
  createdAt               DateTime              @default(now()) @map("created_at")

  profile AssetLiabilityProfile @relation(fields: [assetLiabilityProfileId], references: [id], onDelete: Cascade)

  @@index([assetLiabilityProfileId])
  @@map("user_assets")
}


model RiskProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  // Q1: If your portfolio dropped 20% you would…
  portfolioDrop PortfolioDrop @map("portfolio_drop")

  // Q2: Which investment style suits you best?
  investmentStyle InvestmentStyle @map("investment_style")

  // Q3: What are you aiming for? (multi-select, stored as goals)
  financialAims FinancialAim[] @map("financial_aims")

  // Q4: When do you hope to achieve this?
  timeHorizon TimeHorizon @map("time_horizon")

  // Q5: How do you feel about market fluctuations?
  marketFeeling MarketFeeling @map("market_feeling")

  // Derived category
  riskCategory RiskCategory @map("risk_category")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([riskCategory])
  @@map("risk_profiles")
}
