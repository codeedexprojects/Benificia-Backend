// ════════════════════════════════════════════════════════════
// prisma/schema/financial.prisma
// MODULE 3 — Financial Fact Finding
// ════════════════════════════════════════════════════════════

// Screen: Finance 1 — income sources (multi-select)
model IncomeSourcesProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  incomeSources IncomeSource[] @map("income_sources")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("income_sources_profiles")
}

// Screen: Finance 2 — dependents, spend, insurance, liabilities
model FinanceProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  // Dependents
  numberOfDependents Int @default(0) @map("number_of_dependents")

  // Spend
  householdExpenses   Float @default(0) @map("household_expenses")
  rentAndEmi          Float @default(0) @map("rent_and_emi")
  educationExpenses   Float @default(0) @map("education_expenses")
  otherExpenses       Float @default(0) @map("other_expenses")

  // Insurance
  insuranceMonthly Float @default(0) @map("insurance_monthly")

  // Short-term liabilities
  creditCardDues        Float @default(0) @map("credit_card_dues")
  personalLoan          Float @default(0) @map("personal_loan")
  medicalExpenses       Float @default(0) @map("medical_expenses")
  otherShortTermExpenses Float @default(0) @map("other_short_term_expenses")

  // Long-term liabilities
  homeLoan              Float @default(0) @map("home_loan")
  vehicleLoan           Float @default(0) @map("vehicle_loan")
  educationLoan         Float @default(0) @map("education_loan")
  businessLoan          Float @default(0) @map("business_loan")
  otherLongTermExpenses Float @default(0) @map("other_long_term_expenses")

  // Computed totals
  totalMonthlyExpenses    Float @default(0) @map("total_monthly_expenses")
  totalShortTermLiabilities Float @default(0) @map("total_short_term_liabilities")
  totalLongTermLiabilities  Float @default(0) @map("total_long_term_liabilities")
  monthlySurplus            Float @default(0) @map("monthly_surplus")
  savingsRatioPct           Float @default(0) @map("savings_ratio_pct")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("finance_profiles")
}

// Screen: Finance 3 — total monthly income amount
model IncomeProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  // Amounts — always stored as monthly regardless of how the user entered them
  salaryMonthly    Float  @default(0)          @map("salary_monthly")
  freelanceMonthly Float  @default(0)          @map("freelance_monthly")
  businessMonthly  Float  @default(0)          @map("business_monthly")
  otherMonthly     Float  @default(0)          @map("other_monthly")
  totalMonthly     Float  @default(0)          @map("total_monthly")

  // Period metadata — the unit the user originally chose (monthly | yearly)
  salaryPeriod    String @default("monthly")   @map("salary_period")
  freelancePeriod String @default("monthly")   @map("freelance_period")
  businessPeriod  String @default("monthly")   @map("business_period")
  otherPeriod     String @default("monthly")   @map("other_period")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("income_profiles")
}

// Screen: Finance 5 — assets
model AssetLiabilityProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  residentialProperty Float @default(0) @map("residential_property")
  investment          Float @default(0)
  savingsBank         Float @default(0) @map("savings_bank")
  goldJewelry         Float @default(0) @map("gold_jewelry")
  retirementFunds     Float @default(0) @map("retirement_funds")
  otherAssets         Float @default(0) @map("other_assets")

  // Computed total
  totalAssets Float @default(0) @map("total_assets")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("asset_liability_profiles")
}


// Screen: Goals — what are you aiming for + time horizon
model GoalsProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  financialAims FinancialAim[] @map("financial_aims")
  timeHorizon   TimeHorizon    @map("time_horizon")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("goals_profiles")
}

model RiskProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  portfolioDrop   PortfolioDrop   @map("portfolio_drop")
  investmentStyle InvestmentStyle @map("investment_style")
  marketFeeling   MarketFeeling   @map("market_feeling")
  riskCategory    RiskCategory    @map("risk_category")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([riskCategory])
  @@map("risk_profiles")
}
